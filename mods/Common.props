<Project>

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <!-- 反編譯來源會撞到參照組件裡的同名型別（CS0436），這是預期內的 -->
    <NoWarn>$(NoWarn);CS0436;CS1701;CS1702;CS0618</NoWarn>
    <DebugType>portable</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- 路徑：可用 -p:GameManaged=... / -p:ProfileDir=... 從命令列覆寫 -->
  <PropertyGroup>
    <GameManaged Condition="'$(GameManaged)' == ''">D:\SteamLibrary\steamapps\common\How to Fish\How to Fish\How to Fish_Data\Managed</GameManaged>
    <ProfileDir Condition="'$(ProfileDir)' == ''">$(AppData)\r2modmanPlus-local\HowToFish\profiles\Default</ProfileDir>
    <BepInExCore Condition="'$(BepInExCore)' == ''">$(ProfileDir)\BepInEx\core</BepInExCore>
    <PluginOut Condition="'$(PluginOut)' == ''">$(ProfileDir)\BepInEx\plugins\$(AssemblyName)</PluginOut>
  </PropertyGroup>

  <!--
    遊戲組件。排除規則出自 AI_CONTEXT.md 第 2 節，每一條都踩過坑：
      netstandard.dll  Unity 的是 facade，會和 SDK 的 BCL 打架，造成一堆 CS0518
      mscorlib/System* 同上，由 SDK 提供
      "* - *.dll"      Managed 底下有 Assembly-CSharp 的手動備份（曾叫「- 複製」，
                       現在叫「- 1.0.9」）。不要用固定檔名比對，用這個型樣才不會
                       在對方又改名時載到舊版。
  -->
  <ItemGroup>
    <Reference Include="$(GameManaged)\*.dll"
               Exclude="$(GameManaged)\netstandard.dll;$(GameManaged)\mscorlib.dll;$(GameManaged)\System.dll;$(GameManaged)\System.*.dll;$(GameManaged)\* - *.dll">
      <Private>false</Private>
    </Reference>
    <Reference Include="$(BepInExCore)\BepInEx.dll"><Private>false</Private></Reference>
    <Reference Include="$(BepInExCore)\0Harmony.dll"><Private>false</Private></Reference>
  </ItemGroup>

  <!--
    中英雙語的共用底層。跟這個檔案本身一樣是**編譯期共用**：每個 mod 的 DLL 裡
    都有自己的一份 HtF.Shared.Loc，執行期彼此不相依，單獨安裝也能用。
    ConfigMenu 是用反射找各組件裡的 HtF.Shared.Loc.Term 來翻譯設定名稱的。
  -->
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)Shared\*.cs">
      <Link>Shared\%(Filename)%(Extension)</Link>
    </Compile>
  </ItemGroup>

  <!--
    ============================================================
    版本號的單一來源 = 各專案 .csproj 的 <Version>
    ============================================================

    一個版本號有三個地方要對上：csproj 的 <Version>、[BepInPlugin] 屬性、
    以及 Thunderstore 的 manifest.json。三份字面值一定會有人只改一份——
    改了 csproj 忘了屬性，遊戲裡顯示的還是舊版；改了屬性忘了 manifest，
    Thunderstore 會用舊號碼收下這個包（而且版本號不能重覆上傳，只能再開一版）。

    所以：
      csproj <Version> / <PluginName>  ──產生──>  ModInfo.g.cs  ──>  [BepInPlugin]
                                       ──對帳──>  manifest.json（check_repo.py）

    [BepInPlugin] 的參數必須是編譯期常數，所以不能直接讀 MSBuild 屬性，
    要先產生成 const。產物寫在 obj/ 底下（不進版控），每次建置重新產生。

    **屬性與 Compile 項目都在 target 裡宣告，不在專案層級。** 這不是風格問題：
    $(IntermediateOutputPath) 是 SDK 的 .targets 設的，而 .targets 在這個檔案
    **之後**才被匯入——在專案層級讀它會拿到空字串，檔案就會被寫到專案根目錄。
    target 是執行期才展開的，那時候什麼都齊了。

    同理，target 不能加 Inputs/Outputs：一旦被判定為最新而略過，裡面那個
    <Compile Include> 也不會執行，編譯就會找不到 ModInfo。改用
    WriteOnlyWhenDifferent 避免無謂地讓下游重編。
  -->
  <Target Name="GenerateModInfo" BeforeTargets="CoreCompile">
    <Error Condition="'$(PluginName)' == ''"
           Text="$(MSBuildProjectName).csproj 少了 &lt;PluginName&gt;，[BepInPlugin] 的顯示名稱是從它來的。" />
    <Error Condition="'$(Version)' == ''"
           Text="$(MSBuildProjectName).csproj 少了 &lt;Version&gt;。" />

    <PropertyGroup>
      <GeneratedModInfo>$(IntermediateOutputPath)ModInfo.g.cs</GeneratedModInfo>
    </PropertyGroup>

    <MakeDir Directories="$(IntermediateOutputPath)" />

    <!-- Lines 是用分號分隔的，所以 C# 的分號要寫成 %3B -->
    <ItemGroup>
      <ModInfoLine Include="// &lt;auto-generated /&gt;" />
      <ModInfoLine Include="// 由 mods/Common.props 的 GenerateModInfo 產生。不要編輯，也不要進版控。" />
      <ModInfoLine Include="// 來源：$(MSBuildProjectName).csproj 的 &lt;PluginName&gt; 與 &lt;Version&gt;。" />
      <ModInfoLine Include="namespace $(RootNamespace)" />
      <ModInfoLine Include="{" />
      <ModInfoLine Include="    internal static class ModInfo" />
      <ModInfoLine Include="    {" />
      <ModInfoLine Include="        public const string Name = &quot;$(PluginName)&quot;%3B" />
      <ModInfoLine Include="        public const string Version = &quot;$(Version)&quot;%3B" />
      <ModInfoLine Include="    }" />
      <ModInfoLine Include="}" />
    </ItemGroup>

    <WriteLinesToFile File="$(GeneratedModInfo)"
                      Lines="@(ModInfoLine)"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />

    <ItemGroup>
      <Compile Include="$(GeneratedModInfo)" />
    </ItemGroup>
  </Target>

  <Target Name="CheckPaths" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(GameManaged)\Assembly-CSharp.dll')"
           Text="找不到遊戲組件：$(GameManaged)\Assembly-CSharp.dll。用 -p:GameManaged=&quot;...&quot; 指定。" />
    <Error Condition="!Exists('$(BepInExCore)\BepInEx.dll')"
           Text="找不到 BepInEx：$(BepInExCore)\BepInEx.dll。用 -p:ProfileDir=&quot;...&quot; 指定 r2modman 的 profile。" />
  </Target>

  <Target Name="DeployToProfile" AfterTargets="Build">
    <MakeDir Directories="$(PluginOut)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PluginOut)" ContinueOnError="true" />
    <Message Importance="high" Text="已部署 -> $(PluginOut)\$(TargetFileName)" />
  </Target>

</Project>
